#!/usr/bin/env bash
# Runs the fast checks before every push. Enable once per clone:
#   git config core.hooksPath ci/hooks
# AppInspect and SLIM are slow and need Linux, so they run in CI only. Skip once with: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

bash ci/lint.sh

PY=""
for c in python3 python; do  # the Windows "python3" store stub fails this test and is skipped
  if "$c" -c 'import sys; sys.exit(sys.version_info < (3, 7))' >/dev/null 2>&1; then PY=$c; break; fi
done
if [ -d tests ]; then
  if [ -n "$PY" ]; then "$PY" -m unittest discover -s tests -q; else echo "pre-push: no Python 3 found, unit tests skipped"; fi
  if ls tests/*.test.mjs >/dev/null 2>&1; then
    if command -v node >/dev/null; then node --test tests/*.test.mjs; else echo "pre-push: no node found, JS tests skipped"; fi
  fi
fi
echo "pre-push: ok (AppInspect and SLIM run in CI)"
